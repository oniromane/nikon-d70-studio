#!/usr/bin/env bash
# d70-movie — turn a frame folder into a timelapse.
#
#   ./bin/d70-movie ~/Pictures/D70/interval/sunset
#   ./bin/d70-movie ~/Pictures/D70/interval/sunset 30 out.mp4
#
# 'deflicker' evens out the 1/3-stop exposure jitter you get from any
# aperture-priority or auto-WB frame in the sequence. Harmless if there is none.
set -euo pipefail

DIR="${1:?usage: d70-movie <folder> [fps] [out.mp4]}"
FPS="${2:-24}"
OUT="${3:-$DIR/../$(basename "$DIR")-${FPS}fps.mp4}"

command -v ffmpeg >/dev/null || { echo "ffmpeg not installed — brew install ffmpeg"; exit 1; }

shopt -s nullglob nocaseglob
FRAMES=( "$DIR"/*.jpg )
shopt -u nocaseglob

if (( ${#FRAMES[@]} == 0 )); then
  cat <<EOF
No JPEGs in $DIR.
If you shot NEF, develop them first:
  mkdir -p "$DIR/jpg"
  for f in "$DIR"/*.NEF; do
    dcraw_emu -w -q 3 -T -Z - "\$f" | magick - -resize 1920x "$DIR/jpg/\$(basename "\${f%.NEF}").jpg"
  done
  $0 "$DIR/jpg" $FPS
EOF
  exit 1
fi

echo "${#FRAMES[@]} frames @ ${FPS}fps  ->  $OUT"

# ffmpeg's own -pattern_type glob does NOT understand character classes like
# [Jj], so "*.[Jj][Pp][Gg]" reached it as a literal filename and every run
# failed with "Error opening input file". The shell has already globbed the
# frames correctly, so hand ffmpeg an ordered numbered sequence instead —
# immune to glob dialects, case, and awkward characters in filenames.
TMPD=$(mktemp -d "${TMPDIR:-/tmp}/d70movie.XXXXXX")
cleanup() { rm -rf "$TMPD"; }
trap cleanup EXIT

i=0
for f in "${FRAMES[@]}"; do
  abs="$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"
  ln -s "$abs" "$TMPD/$(printf '%05d' "$i").jpg"
  i=$((i + 1))
done

# deflicker needs at least `size` frames to average over.
DFSIZE=10
(( ${#FRAMES[@]} < DFSIZE )) && DFSIZE=${#FRAMES[@]}
VF="scale=1920:-2:flags=lanczos"
(( DFSIZE >= 3 )) && VF="deflicker=mode=pm:size=${DFSIZE},${VF}"

if ffmpeg -y -loglevel error -framerate "$FPS" -i "$TMPD/%05d.jpg" \
     -vf "$VF" -c:v libx264 -crf 18 -preset slow -pix_fmt yuv420p "$OUT"; then
  echo "Wrote $OUT"
else
  echo "ffmpeg failed. Re-run without -loglevel error to see why." >&2
  exit 1
fi
