#!/usr/bin/env bash
# d70-onion — onion-skinning for a camera with no live view.
#
#   ./bin/d70-onion ~/Pictures/D70/tether/claymation
#   ./bin/d70-onion ~/Pictures/D70/tether/claymation 3    # blend last 3 frames
#
# Run d70-tether into a folder, run this against the same folder, then open the
# onion.html it writes. The page refreshes itself, so every time you shoot,
# the browser shows the last N frames blended together — which is exactly the
# reference you need to pose the next one.
set -euo pipefail

DIR="${1:?usage: d70-onion <folder> [frames-to-blend]}"
N="${2:-2}"
mkdir -p "$DIR"

command -v magick >/dev/null || { echo "ImageMagick not installed — brew install imagemagick"; exit 1; }

cat > "$DIR/onion.html" <<'HTML'
<!doctype html><meta charset="utf-8"><title>onion skin</title>
<meta http-equiv="refresh" content="2">
<style>
  html,body{margin:0;height:100%;background:#111;display:grid;place-items:center}
  img{max-width:100vw;max-height:100vh;object-fit:contain;image-rendering:auto}
  p{color:#777;font:14px system-ui}
</style>
<img src="onion.jpg?x=0" onerror="this.replaceWith(Object.assign(document.createElement('p'),{textContent:'waiting for the first frames…'}))">
<script>
  // bust the cache so the refresh actually shows the new blend
  document.querySelector('img')?.setAttribute('src','onion.jpg?x='+Date.now());
</script>
HTML

echo "Watching : $DIR"
echo "Blending : last $N frames"
echo "Open     : file://$(cd "$DIR" && pwd)/onion.html"
echo "Ctrl-C to stop."
echo

# Newest N frames, excluding our own output. Deliberately NOT `ls | grep`:
# that would also drop a real frame whose name merely contained "onion", and
# it breaks on any unusual character. This globs, filters by exact basename,
# and sorts on the mtime stat reports.
newest_frames() {
  local dir="$1" want="$2" f list=()
  shopt -s nullglob nocaseglob
  for f in "$dir"/*.jpg "$dir"/*.jpeg; do
    [[ "$(basename "$f")" == onion.jpg ]] && continue
    list+=( "$f" )
  done
  shopt -u nocaseglob nullglob
  (( ${#list[@]} )) || return 1
  local f2
  for f2 in "${list[@]}"; do
    printf '%s\t%s\n' "$(stat -f %m "$f2")" "$f2"
  done | sort -rn | head -"$want" | cut -f2-
}

LAST=""
while true; do
  # Stock macOS ships bash 3.2, which has no mapfile/readarray. Read loop it is.
  SET=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && SET+=( "$line" )
  done < <(newest_frames "$DIR" "$N")
  if (( ${#SET[@]} > 0 )) && [[ "${SET[0]}" != "$LAST" ]]; then
    if magick "${SET[@]}" -resize 1400x -evaluate-sequence mean "$DIR/onion.jpg.tmp" 2>/dev/null; then
      mv "$DIR/onion.jpg.tmp" "$DIR/onion.jpg"
      echo "  blended $(basename "${SET[0]}") (${#SET[@]} frames)"
    fi
    LAST="${SET[0]}"
  fi
  sleep 1
done
