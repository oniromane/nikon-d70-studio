def busy_job():
    for j in JOBS.values():
        if j["running"] and j["camera"]:
            return j["id"]
    return None


JOB_LOCK = threading.Lock()


def start_job(kind, values):
    global JOB_SEQ
    spec = JOB_SPECS.get(kind)
    if not spec:
        return None, f"unknown job: {kind}"
    if spec["camera"]:
        held = busy_job()
        if held:
            return None, f"camera already held by job {held}"

    argv = [str(BIN / spec["script"])]
    for a in spec["args"]:
        v = (values.get(a["name"]) or "").strip()
        if not v:
            continue
        if spec.get("expand_last") and a["name"] == "values":
            argv.extend(shlex.split(v))
        else:
            argv.append(v)

    if spec["camera"]:
        free_ptpcamerad()

    with JOB_LOCK:
        JOB_SEQ += 1
        jid = f"{kind}-{JOB_SEQ}"
    logdir = ROOT / ".studio-logs"
    logdir.mkdir(parents=True, exist_ok=True)
    logpath = logdir / f"{jid}.log"
    logf = open(logpath, "wb")
    try:
        proc = subprocess.Popen(argv, stdout=logf, stderr=subprocess.STDOUT,
                                cwd=str(PROJECT), start_new_session=True)
    except Exception as exc:                                    # noqa: BLE001
        logf.close()
        return None, str(exc)

    JOBS[jid] = {"id": jid, "kind": kind, "label": spec["label"], "argv": argv,
                 "camera": spec["camera"], "proc": proc, "log": str(logpath),
                 "started": time.time(), "running": True, "rc": None}
    threading.Thread(target=_reap, args=(jid, logf), daemon=True).start()
    return jid, None


def _reap(jid, logf):
    j = JOBS[jid]
    j["proc"].wait()
    j["rc"] = j["proc"].returncode
    j["running"] = False
    j["ended"] = time.time()
    try:
        logf.close()
    except Exception:                                           # noqa: BLE001
        pass


def stop_job(jid):
    j = JOBS.get(jid)
    if not j:
        return False, "no such job"
    if not j["running"]:
        return False, "already finished"
    try:
        os.killpg(os.getpgid(j["proc"].pid), signal.SIGTERM)
    except Exception:                                           # noqa: BLE001
        j["proc"].terminate()
    return True, "stopping"


def job_view(tail=40):
    out = []
    for j in sorted(JOBS.values(), key=lambda x: x["started"], reverse=True)[:12]:
        try:
            lines = Path(j["log"]).read_text(errors="replace").splitlines()[-tail:]
        except Exception:                                       # noqa: BLE001
            lines = []
        out.append({"id": j["id"], "label": j["label"], "kind": j["kind"],
                    "running": j["running"], "rc": j["rc"], "camera": j["camera"],
                    "started": j["started"], "cmd": " ".join(j["argv"]),
                    "log": lines})
    return out


def recent_frames(limit=12):
    if not ROOT.exists():
        return []
    files = []
    for p in ROOT.rglob("*"):
        if p.suffix.lower() in (".jpg", ".jpeg") and ".studio-logs" not in p.parts:
            try:
                files.append((p.stat().st_mtime, p))
            except OSError:
                pass
    files.sort(reverse=True)
    return [{"path": str(p.relative_to(ROOT)), "mtime": m} for m, p in files[:limit]]


