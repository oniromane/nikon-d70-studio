#!/usr/bin/env python3
"""
d70-studio — a local control surface for the Nikon D70.

    ./bin/d70-studio            # then open http://127.0.0.1:8070
    ./bin/d70-studio --port 9000

Everything in the operator's guide, wired to the camera:
  * live camera status and settings over PTP
  * the shooting recipes from section 03, applied with one click
  * all 40 projects, each pre-filling the right job
  * job launcher with live logs for the 13 bin/d70-* scripts
  * the reference tables — display codes, traps, reset combos

Python 3 standard library only. No pip, no npm.

Design notes that matter:
  * The D70 has NO live view. The preview pane shows the LAST CAPTURED FRAME,
    which is the honest affordance for this body.
  * gphoto2 cannot share the camera. Every camera operation takes CAMERA_LOCK,
    and only one camera-touching job may run at a time.
  * The D70's PTP config key names are not documented anywhere I could verify,
    so they are DISCOVERED at connect time from `gphoto2 --list-config` and
    matched against candidate names. The resolved map is shown in the UI.
"""

import argparse, html, json, mimetypes, os, re, shlex, shutil, signal
import subprocess, threading, time, urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

HERE     = Path(__file__).resolve().parent
PROJECT  = HERE.parent
BIN      = HERE
UI_FILE  = HERE / "d70-studio.html"
ROOT     = Path(os.environ.get("D70_ROOT", Path.home() / "Pictures" / "D70"))

# Hugin's CLI ships inside the app bundle, not on the default PATH. Add it here
# so both shutil.which() and every job we spawn can see enfuse/align_image_stack.
HUGIN = Path("/Applications/Hugin/tools_mac")
if HUGIN.is_dir() and str(HUGIN) not in os.environ.get("PATH", ""):
    os.environ["PATH"] = os.environ.get("PATH", "") + ":" + str(HUGIN)

CAMERA_LOCK = threading.Lock()
STATE_LOCK  = threading.Lock()

STATE = {
    "detected":   False,
    "model":      "",
    "port":       "",
    "keys":       {},        # logical name -> actual gphoto2 config path
    "unresolved": [],
    "settings":   {},        # logical name -> {"current":…, "choices":[…]}
    "error":      "",
    "checked_at": 0.0,
    "abilities":  [],
}

JOBS = {}                    # id -> dict
JOB_SEQ = 0


# ─────────────────────────────────────────────────────────── camera plumbing ──

def gphoto_available():
    return shutil.which("gphoto2") is not None


def free_ptpcamerad():
    """macOS claims any PTP camera the instant it enumerates. Take it back.

    Verified the hard way on real hardware:
      * one killall is NOT enough — launchd restarts it immediately, so the
        `killall; sleep 1` idiom hands the window straight back;
      * the agent cannot be unloaded: `launchctl bootout` fails with
        "Operation not permitted while System Integrity Protection is engaged".
    What works is SIGKILL followed by an immediate claim, with no gap.
    """
    subprocess.run(["killall", "-9", "ptpcamerad"], capture_output=True)


def gp(args, timeout=40, tries=20):
    """Run gphoto2, racing ptpcamerad for the interface.

    A lost claim fails in milliseconds, so a fast failure is retried and a slow
    one is returned as a genuine error.
    """
    if not gphoto_available():
        return 127, "", "gphoto2 is not installed — run ./bin/d70-setup"
    last = (1, "", "no attempt made")
    for _ in range(tries):
        free_ptpcamerad()                       # no sleep — that is the point
        t0 = time.time()
        try:
            p = subprocess.run(["gphoto2", *args], capture_output=True,
                               text=True, timeout=timeout)
        except subprocess.TimeoutExpired:
            return 124, "", "gphoto2 timed out (camera asleep, or busy?)"
        except Exception as exc:                               # noqa: BLE001
            return 1, "", str(exc)
        if p.returncode == 0:
            return 0, p.stdout, p.stderr
        last = (p.returncode, p.stdout, p.stderr)
        if time.time() - t0 > 3:                # ran a while → real failure
            break
        if "claim" not in (p.stderr or "").lower():
            break
    return last


def split_blocks(text):
    """gphoto2 prints one block per --get-config, separated by a bare END, with
    no key path echoed. Blocks are therefore paired positionally with the keys
    that were requested."""
    out, cur = [], []
    for line in text.splitlines():
        if line.strip() == "END":
            out.append("\n".join(cur)); cur = []
        else:
            cur.append(line)
    if cur and any(l.strip() for l in cur):
        out.append("\n".join(cur))
    return out


# The D70's real config tree, read off the body (firmware V1.02): 210 keys, of
# which 107 are named and 103 are raw PTP property codes under /main/other.
# Studio still *discovers* rather than hardcodes — the leaf names below are
# matched against what `gphoto2 --list-config` actually returns — but every one
# of these has been confirmed present on this camera.
GROUPS = [
    ("Exposure", ["expprogram", "shutterspeed", "f-number", "iso",
                  "exposurecompensation", "exposuremetermode", "evstep",
                  "flexibleprogram", "exposurelock"]),
    ("Image", ["imagequality", "imagesize", "whitebalance", "colormodel",
               "optimizeimage", "sharpening", "tonecompensation",
               "saturation", "hueadjustment"]),
    ("Focus", ["focusmode", "autofocusarea", "focusmetermode", "focusareawrap",
               "assistlight"]),
    ("Flash", ["flashmode", "nikonflashmode", "flashexposurecompensation",
               "flashmodemanualpower", "flashcommandermode",
               "flashcommanderpower", "flashshutterspeed", "flashsign"]),
    ("Drive & timing", ["capturemode", "burstnumber", "selftimerdelay",
                        "remotetimeout", "longexpnr", "bracketing",
                        "bracketset", "bracketorder", "aebracketingcount"]),
    ("Body", ["csmmenu", "viewfindergrid", "imagereview", "afbeep",
              "centerweightsize", "aelaflmode", "autoiso",
              "minimumshutterspeed", "lcdofftime", "imagerotationflag",
              "filenrsequencing", "nocfcardrelease", "reversedial",
              "capturetarget", "recordingmedia"]),
    ("Comment", ["imagecomment", "imagecommentenable"]),
    ("Status", ["cameramodel", "deviceversion", "serialnumber", "batterylevel",
                "acpower", "lensname", "focallength", "minfocallength",
                "maxfocallength", "lightmeter", "externalflash",
                "externalflashready", "flashopen", "flashcharged",
                "maximumshots", "orientation", "lowlight"]),
]

# Actions are momentary, not settings — they fire rather than hold a value.
ACTIONS = {
    "bulb":           "Bulb — hold the shutter open (TOGGLE)",
    "autofocusdrive": "Drive autofocus once",
}

CANDIDATES = {k: [k] for _, keys in GROUPS for k in keys}
CANDIDATES.update({k: [k] for k in ACTIONS})
# a couple of bodies name these differently; keep the fallbacks
CANDIDATES["shutterspeed"] = ["shutterspeed", "shutterspeed2"]
CANDIDATES["exposurecompensation"] = ["exposurecompensation", "exposurecompensation2"]
CANDIDATES["focusmode"] = ["focusmode", "focusmode2"]

# gphoto2 reports Readonly per key, so nothing needs hardcoding here.
READONLY = set()

def parse_config_block(text):
    """Turn `gphoto2 --get-config` output into {'current':…, 'choices':[…]}."""
    current, choices, label, typ, ro = None, [], None, None, False
    for line in text.splitlines():
        line = line.rstrip()
        if line.startswith("Label:"):
            label = line.split(":", 1)[1].strip()
        elif line.startswith("Readonly:"):
            ro = line.split(":", 1)[1].strip() == "1"
        elif line.startswith("Type:"):
            typ = line.split(":", 1)[1].strip()
        elif line.startswith("Current:"):
            current = line.split(":", 1)[1].strip()
        elif line.startswith("Choice:"):
            m = re.match(r"Choice:\s*\d+\s+(.*)$", line)
            if m:
                choices.append(m.group(1))
    return {"label": label, "type": typ, "current": current,
            "choices": choices, "readonly": ro}


def refresh(force=False):
    """Detect the camera, resolve its config key names, read current values."""
    with STATE_LOCK:
        fresh = (time.time() - STATE["checked_at"]) < 2.0
    if fresh and not force:
        return snapshot()

    if busy_job():
        with STATE_LOCK:
            STATE["error"] = "camera busy — a job is holding it"
            STATE["checked_at"] = time.time()
        return snapshot()

    with CAMERA_LOCK:
        free_ptpcamerad()
        time.sleep(0.4)

        rc, out, err = gp(["--auto-detect"], timeout=20)
        detected, model, port = False, "", ""
        for line in out.splitlines():
            if re.search(r"usb:", line):
                parts = re.split(r"\s{2,}", line.strip())
                if parts:
                    model = parts[0].strip()
                    port = parts[-1].strip()
                    detected = True
                break

        keys, unresolved, settings, abilities = {}, [], {}, []
        if detected:
            rc2, listing, _ = gp(["--list-config"], timeout=25)
            available = [l.strip() for l in listing.splitlines() if l.strip().startswith("/")]
            leaf = {p.rsplit("/", 1)[-1]: p for p in available}

            for logical, names in CANDIDATES.items():
                hit = next((leaf[n] for n in names if n in leaf), None)
                if hit:
                    keys[logical] = hit
                else:
                    unresolved.append(logical)

            # One invocation for everything: each gphoto2 call has to win the
            # race against ptpcamerad, so minimise how many races we run.
            names = list(keys.keys())
            argv = []
            for n in names:
                argv += ["--get-config", keys[n]]
            if argv:
                rc3, out3, _ = gp(argv, timeout=90)
                if rc3 == 0:
                    blocks = split_blocks(out3)
                    for n, blk in zip(names, blocks):
                        settings[n] = parse_config_block(blk)

            rc4, ab, _ = gp(["--abilities"], timeout=15)
            abilities = [l.strip() for l in ab.splitlines() if l.strip()]

    with STATE_LOCK:
        STATE.update(detected=detected, model=model, port=port, keys=keys,
                     unresolved=unresolved, settings=settings,
                     abilities=abilities, checked_at=time.time(),
                     error="" if detected else (err.strip() or "no camera found"))
    return snapshot()


def snapshot():
    with STATE_LOCK:
        return json.loads(json.dumps(STATE))


def set_setting(logical, value):
    with STATE_LOCK:
        path = STATE["keys"].get(logical)
    if not path:
        return False, f"no config key resolved for {logical}"
    with STATE_LOCK:
        meta = STATE["settings"].get(logical) or {}
    if meta.get("readonly"):
        return False, f"{logical} is read-only on this body"
    if busy_job():
        return False, "camera busy — stop the running job first"
    with CAMERA_LOCK:
        free_ptpcamerad()
        rc, out, err = gp(["--set-config", f"{path}={value}"], timeout=20)
    if rc != 0:
        return False, (err.strip() or out.strip() or "rejected by camera")
    return True, f"{logical} = {value}"


def capture_now():
    if busy_job():
        return False, "camera busy — stop the running job first"
    dest = ROOT / "studio"
    dest.mkdir(parents=True, exist_ok=True)
    with CAMERA_LOCK:
        free_ptpcamerad()
        rc, out, err = gp(["--capture-image-and-download",
                           "--filename", str(dest / "%Y%m%d_%H%M%S_%f.%C")],
                          timeout=90)
    if rc != 0:
        return False, (err.strip() or out.strip() or "capture failed")
    return True, out.strip().splitlines()[-1] if out.strip() else "captured"


