# ────────────────────────────────────────────────────────────────────── http ──

def jbody(handler):
    n = int(handler.headers.get("Content-Length") or 0)
    if not n:
        return {}
    try:
        return json.loads(handler.rfile.read(n).decode())
    except Exception:                                           # noqa: BLE001
        return {}


class Handler(BaseHTTPRequestHandler):
    server_version = "d70-studio"

    def log_message(self, *a):                                  # quiet
        pass

    def _send(self, code, body, ctype="application/json"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode()
        elif isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    # ------------------------------------------------------------------ GET --
    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        p, q = u.path, urllib.parse.parse_qs(u.query)

        if p in ("/", "/index.html"):
            try:
                return self._send(200, UI_FILE.read_text(), "text/html; charset=utf-8")
            except FileNotFoundError:
                return self._send(500, f"<h1>missing {UI_FILE}</h1>", "text/html")

        if p == "/api/boot":
            return self._send(200, {
                "root": str(ROOT), "project": str(PROJECT),
                "gphoto2": shutil.which("gphoto2") or "",
                "tools": {t: bool(shutil.which(t)) for t in
                          ("gphoto2", "exiftool", "magick", "ffmpeg", "dcraw_emu",
                           "align_image_stack", "enfuse")},
                "recipes": RECIPES, "projects": PROJECTS,
                "jobspecs": {k: {kk: vv for kk, vv in v.items() if kk != "script"}
                             for k, v in JOB_SPECS.items()},
                "codes": DISPLAY_CODES, "traps": TRAPS, "resets": RESETS,
                "groups": [{"name": n, "keys": k} for n, k in GROUPS],
                "actions": ACTIONS,
            })

        if p == "/api/status":
            return self._send(200, {"camera": refresh(force=("force" in q)),
                                    "busy": busy_job()})

        if p == "/api/jobs":
            return self._send(200, {"jobs": job_view(), "busy": busy_job()})

        if p == "/api/frames":
            return self._send(200, {"frames": recent_frames()})

        if p.startswith("/frame/"):
            rel = urllib.parse.unquote(p[len("/frame/"):])
            target = (ROOT / rel).resolve()
            try:
                target.relative_to(ROOT.resolve())
            except ValueError:
                return self._send(403, {"error": "outside the library"})
            if not target.is_file():
                return self._send(404, {"error": "not found"})
            ctype = mimetypes.guess_type(str(target))[0] or "application/octet-stream"
            data = target.read_bytes()
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            return self.wfile.write(data)

        return self._send(404, {"error": "no such route"})

    # ----------------------------------------------------------------- POST --
    def do_POST(self):
        p = urllib.parse.urlparse(self.path).path
        body = jbody(self)

        if p == "/api/config":
            ok, msg = set_setting(body.get("key", ""), body.get("value", ""))
            refresh(force=True)
            return self._send(200 if ok else 400, {"ok": ok, "message": msg})

        if p == "/api/recipe":
            rec = next((r for r in RECIPES if r["id"] == body.get("id")), None)
            if not rec:
                return self._send(404, {"ok": False, "message": "no such recipe"})
            applied, refused = [], []
            for k, v in rec["set"].items():
                ok, msg = set_setting(k, v)
                (applied if ok else refused).append(msg)
            refresh(force=True)
            return self._send(200, {"ok": True, "applied": applied,
                                    "refused": refused, "manual": rec["manual"]})

        if p == "/api/capture":
            ok, msg = capture_now()
            return self._send(200 if ok else 400, {"ok": ok, "message": msg})

        if p == "/api/action":
            name = body.get("name", "")
            with STATE_LOCK:
                path = STATE["keys"].get(name)
            if not path:
                return self._send(404, {"ok": False, "message": f"no action {name}"})
            if busy_job():
                return self._send(400, {"ok": False, "message": "camera busy"})
            val = body.get("value", "1")
            with CAMERA_LOCK:
                rc, out, err = gp(["--set-config", f"{path}={val}"], timeout=30)
            ok = rc == 0
            refresh(force=True)
            return self._send(200 if ok else 400,
                              {"ok": ok, "message": (err or out or f"{name}={val}").strip()})

        if p == "/api/ptpcamerad":
            free_ptpcamerad()
            return self._send(200, {"ok": True, "message": "ptpcamerad released"})

        if p == "/api/job":
            jid, err = start_job(body.get("kind", ""), body.get("values") or {})
            return self._send(200 if jid else 400,
                              {"ok": bool(jid), "id": jid, "message": err or "started"})

        if p == "/api/job/stop":
            ok, msg = stop_job(body.get("id", ""))
            return self._send(200 if ok else 400, {"ok": ok, "message": msg})

        return self._send(404, {"error": "no such route"})


def main():
    ap = argparse.ArgumentParser(description="Local control surface for the Nikon D70")
    ap.add_argument("--port", type=int, default=8070)
    ap.add_argument("--host", default="127.0.0.1")
    args = ap.parse_args()

    ROOT.mkdir(parents=True, exist_ok=True)
    srv = ThreadingHTTPServer((args.host, args.port), Handler)

    print(f"d70-studio  →  http://{args.host}:{args.port}")
    print(f"library     →  {ROOT}")
    print(f"gphoto2     →  {shutil.which('gphoto2') or 'NOT INSTALLED — run ./bin/d70-setup'}")
    print("Ctrl-C to stop.\n")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nstopping…")
        for j in JOBS.values():
            if j["running"]:
                stop_job(j["id"])
        srv.shutdown()


if __name__ == "__main__":
    main()
