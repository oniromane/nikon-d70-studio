    ["Linear polariser on lens", "Manual p.191: the D70 cannot be used with them",                  "Circular, marked C-PL"],
]

RESETS = [
    ["Two-button reset", "Hold BKT + metering (the two green dots) for 2 s",
     "Shooting mode, focus area, metering, exp comp, bracketing, flash mode, quality, size, WB, ISO, Optimize image. Custom Settings survive. (p.111)"],
    ["Format card", "Hold the two red FORMAT buttons for 2 s, then again to confirm",
     "Erases everything including protected images. Always format in-camera. (p.21)"],
    ["Custom Settings reset", "CSM menu → R Menu reset → Reset", "All 25 Custom Settings (p.136)"],
    ["Unlock the full menu", "Setup → CSM menu → Detailed", "Reveals Custom Settings 10–25. Do this first. (p.161)"],
]


# ── gear ─────────────────────────────────────────────────────────────────────
# What the owner actually has. Persisted next to the picture library rather than
# inside the app bundle, so reinstalling the app never loses it.

GEAR_FILE = ROOT / "gear.json"
GEAR_LOCK = threading.Lock()


def load_gear():
    if GEAR_FILE.is_file():
        try:
            owned = set(json.loads(GEAR_FILE.read_text()).get("owned", []))
            return {g for g in owned if g in GEAR_BY_ID}
        except Exception:                                       # noqa: BLE001
            pass
    return set(CORE)                    # a body, a lens, a card — assume these


def save_gear(owned):
    """Caller owns the locking; this just writes."""
    ROOT.mkdir(parents=True, exist_ok=True)
    tmp = GEAR_FILE.with_suffix(".json.tmp")
    tmp.write_text(json.dumps({"owned": sorted(owned)}, indent=2))
    tmp.replace(GEAR_FILE)          # atomic swap: never a half-written file


OWNED = load_gear()


def _met(req, owned):
    """One requirement. A list means any one of them will do."""
    if isinstance(req, list):
        return any(r in owned for r in req)
    return req in owned


def missing_for(project, owned):
    """Which requirements are unmet, as gear ids (alternatives kept grouped)."""
    return [r for r in project["requires"] if not _met(r, owned)]


def gear_label(req):
    if isinstance(req, list):
        return " or ".join(GEAR_BY_ID[r]["name"] for r in req if r in GEAR_BY_ID)
    return GEAR_BY_ID[req]["name"] if req in GEAR_BY_ID else req


def projects_view(owned):
    out = []
    for p in PROJECTS:
        miss = missing_for(p, owned)
        out.append({**p, "runs": not miss,
                    "missing": [gear_label(r) for r in miss],
                    "missingIds": [r if isinstance(r, list) else [r] for r in miss]})
    return out


def gear_view(owned):
    """Every item, whether it is owned, and how many projects it would unlock."""
    rows = []
    for g in GEAR:
        held = g["id"] in owned
        # projects blocked ONLY by this item — its true marginal value
        unlocks = 0
        for p in PROJECTS:
            miss = missing_for(p, owned)
            if len(miss) == 1 and _met(miss[0], {g["id"]}):
                unlocks += 1
        used_by = sum(1 for p in PROJECTS
                      if any(g["id"] in (r if isinstance(r, list) else [r])
                             for r in p["requires"]))
        rows.append({**g, "owned": held, "unlocks": unlocks, "usedBy": used_by})
    return rows


# ── pre-flight ───────────────────────────────────────────────────────────────
# The camera already reports everything needed to catch the expensive mistakes:
# a 240-frame ramp started on a flat battery, a four-hour interval run with
# image review on, a sequence in aperture priority that will pump brightness for
# four hours. None of that is worth discovering afterwards.

def _num(txt):
    """Pull the first number out of something like '25%' or '0,0062s'."""
    if txt is None:
        return None
    m = re.search(r"-?\d+(?:[.,]\d+)?", str(txt))
    return float(m.group(0).replace(",", ".")) if m else None


def job_shape(kind, values):
    """How many frames a job intends to take, and roughly how long for."""
    def g(k, d=0):
        v = _num(values.get(k))
        return d if v is None else v          # a real 0 is not the same as absent
    if kind == "interval":
        n = int(g("frames", 0)); return n, n * g("seconds", 0)
    if kind == "bulbramp":
        n = int(g("frames", 0)); return n, n * 8          # ~8 s a cycle, rough
    if kind == "sweep":
        return len(shlex.split(values.get("values", ""))), 0
    if kind in ("tether", "connect", "settings"):
        return 0, 0
    return 0, 0


PREFLIGHT_WANTS = {
    # kind: (setting, wanted-substring, why)
    "interval": [("expprogram", "M",        "Any auto mode re-decides exposure every frame and the sequence pumps."),
                 ("focusmode",  "Manual",   "Autofocus hunts between frames and shifts the framing."),
                 ("whitebalance", "!Automatic", "Auto white balance drifts frame to frame."),
                 ("imagereview", "Off",     "The screen is the biggest battery drain on this camera.")],
    "bulbramp": [("expprogram", "M",        "The ramp sets the shutter itself; an auto mode will fight it."),
                 ("focusmode",  "Manual",   "Autofocus hunts between frames."),
                 ("whitebalance", "!Automatic", "Auto white balance drifts frame to frame."),
                 ("longexpnr",  "Off",      "Noise reduction doubles each cycle and gaps the sequence.")],
    "sweep":    [("expprogram", "M",        "Most settings are read-only in the scene modes and in P.")],
}


def preflight(kind, values):
    """Returns a list of {level, text, why}. level: block | warn | ok | info."""
    out = []
    spec = JOB_SPECS.get(kind)
    if not spec:
        return [{"level": "block", "text": f"Unknown job {kind!r}", "why": ""}]

    if not spec["camera"]:
        return [{"level": "ok", "text": "This job never touches the camera.", "why": ""}]

    held = busy_job()
    if held:
        out.append({"level": "block", "text": f"Camera is held by job {held}.",
                    "why": "gphoto2 cannot share the device. Stop it first."})

    cam = refresh()
    if not cam["detected"]:
        out.append({"level": "block", "text": "No camera detected.",
                    "why": "Check Setup → USB → PTP, and that the cable goes straight to the Mac."})
        return out

    st = cam["settings"]
    cur = lambda k: (st.get(k) or {}).get("current")
    frames, seconds = job_shape(kind, values)

    # --- power ---
    batt = _num(cur("batterylevel"))
    ac   = (cur("acpower") or "").lower().startswith("on")
    if ac:
        out.append({"level": "ok", "text": "Running on mains (EH-5).", "why": ""})
    elif batt is not None:
        long_run = frames >= 120 or seconds >= 1800
        if batt < 30 and long_run:
            out.append({"level": "block", "text": f"Battery {batt:.0f}% for a {frames}-frame run.",
                        "why": "This will die partway through. Connect the EH-5 or charge first."})
        elif batt < 50 and long_run:
            out.append({"level": "warn", "text": f"Battery {batt:.0f}% for a {frames}-frame run.",
                        "why": "A fresh EN-EL3 manages roughly 400 shots with normal use. Mains is safer."})
        else:
            out.append({"level": "ok", "text": f"Battery {batt:.0f}%.", "why": ""})

    # --- room on the card ---
    shots = _num(cur("maximumshots"))
    if shots is not None and frames:
        if shots < frames:
            out.append({"level": "block", "text": f"Card holds {shots:.0f} more frames; this needs {frames}.",
                        "why": "Offload the card, or drop to a smaller image quality."})
        elif shots < frames * 1.15:
            out.append({"level": "warn", "text": f"Card holds {shots:.0f}; this needs {frames}.",
                        "why": "Almost no margin. Offload first if you can."})
        else:
            out.append({"level": "ok", "text": f"Card has room for {shots:.0f} frames.", "why": ""})

    # --- lens ---
    if (cur("lensname") or "").lower() in ("unknown", "", "none"):
        out.append({"level": "warn", "text": "No CPU lens reported.",
                    "why": "Metering and aperture control are unavailable; the panel shows F--."})

    # --- the sequence-discipline checks ---
    for key, want, why in PREFLIGHT_WANTS.get(kind, []):
        val = cur(key)
        if val is None:
            continue
        neg = want.startswith("!")
        target = want[1:] if neg else want
        hit = target.lower() in str(val).lower()
        bad = hit if neg else not hit
        if bad:
            label = (st.get(key) or {}).get("label") or key
            out.append({"level": "warn",
                        "text": f"{label} is “{val}” — wanted {'anything but ' if neg else ''}{target}.",
                        "why": why})

    if not any(o["level"] in ("warn", "block") for o in out):
        out.append({"level": "ok", "text": "Nothing looks wrong.", "why": ""})
    return out


# ── frame inspection ─────────────────────────────────────────────────────────

EXIF_TAGS = ["DateTimeOriginal", "Model", "LensID", "LensSpec", "FocalLength",
             "ExposureTime", "FNumber", "ISO", "ExposureProgram", "MeteringMode",
             "WhiteBalance", "Flash", "FocusMode", "Quality", "ImageSize",
             "ColorSpace", "Sharpness", "ToneComp", "Saturation", "HueAdjustment",
             "ExposureCompensation", "ShutterCount", "Comment", "FileSize"]


def frame_meta(rel):
    """EXIF for one frame, as {label: value}, in a sensible order."""
    target = (ROOT / rel).resolve()
    try:
        target.relative_to(ROOT.resolve())
    except ValueError:
        return None, "outside the library"
    if not target.is_file():
        return None, "not found"
    if not shutil.which("exiftool"):
        return None, "exiftool not installed"
    p = subprocess.run(["exiftool", "-json", "-fast2", *[f"-{t}" for t in EXIF_TAGS],
                        str(target)], capture_output=True, text=True, timeout=25)
    try:
        raw = json.loads(p.stdout)[0]
    except Exception:                                           # noqa: BLE001
        return None, "could not read metadata"
    rows = [(t, raw[t]) for t in EXIF_TAGS if t in raw and raw[t] not in ("", None)]
    return rows, None


def frame_histogram(rel, bins=64):
    """RGB + luma histogram, computed by ImageMagick so it works for NEF too."""
    target = (ROOT / rel).resolve()
    try:
        target.relative_to(ROOT.resolve())
    except ValueError:
        return None
    if not target.is_file() or not shutil.which("magick"):
        return None
    # Downsample hard: 160x160 is ample for a histogram and keeps this instant.
    p = subprocess.run(["magick", str(target) + "[0]", "-colorspace", "sRGB",
                        "-resize", "160x160", "-depth", "8", "RGB:-"],
                       capture_output=True, timeout=40)
    if p.returncode != 0 or not p.stdout:
        return None
    data = p.stdout
    r = [0] * bins; g = [0] * bins; b = [0] * bins; l = [0] * bins
    step = 256 // bins
    for i in range(0, len(data) - 2, 3):
        rv, gv, bv = data[i], data[i + 1], data[i + 2]
        r[rv // step] += 1; g[gv // step] += 1; b[bv // step] += 1
        l[int(0.2126 * rv + 0.7152 * gv + 0.0722 * bv) // step] += 1
    n = max(1, max(max(r), max(g), max(b), max(l)))
    clip_lo = sum(1 for i in range(0, len(data) - 2, 3)
                  if data[i] < 2 and data[i+1] < 2 and data[i+2] < 2)
    clip_hi = sum(1 for i in range(0, len(data) - 2, 3)
                  if data[i] > 253 and data[i+1] > 253 and data[i+2] > 253)
    px = max(1, len(data) // 3)
    return {"bins": bins, "r": r, "g": g, "b": b, "l": l, "peak": n,
            "clipLow": round(100 * clip_lo / px, 2),
            "clipHigh": round(100 * clip_hi / px, 2)}


# ── tagging, snapshots, the card ─────────────────────────────────────────────

def tag_project(n):
    """Write a project id into the camera's Image Comment.

    The D70 stamps a 36-character comment into every frame's EXIF, and typing it
    on the four-way pad is miserable. Setting it from here means frames tag
    themselves at source, so a shoot stays identifiable without a naming
    convention anyone has to remember.
    """
    try:
        n = int(n)
    except (TypeError, ValueError):
        return False, f"project number must be a number, got {n!r}"
    proj = next((p for p in PROJECTS if p["n"] == n), None)
    if not proj:
        return False, f"no project {n}"
    text = f"P{proj['n']:03d} {proj['title']}"[:36]
    with STATE_LOCK:
        kc = STATE["keys"].get("imagecomment")
        ke = STATE["keys"].get("imagecommentenable")
    if not kc:
        return False, "camera does not expose imagecomment (is it connected?)"
    if busy_job():
        return False, "camera busy"
    with CAMERA_LOCK:
        rc, out, err = gp(["--set-config", f"{kc}={text}"], timeout=25)
        if rc == 0 and ke:
            gp(["--set-config", f"{ke}=1"], timeout=20)
    refresh(force=True)
    if rc != 0:
        return False, (err or out or "camera rejected the comment").strip()
    return True, f"every frame now tagged “{text}”"


SNAP_DIR = ROOT / "snapshots"


def snapshot_list():
    if not SNAP_DIR.is_dir():
        return []
    out = []
    for f in sorted(SNAP_DIR.glob("*.json")):
        try:
            d = json.loads(f.read_text())
            out.append({"name": f.stem, "count": len(d.get("settings", {})),
                        "saved": d.get("saved", "")})
        except Exception:                                       # noqa: BLE001
            pass
    return out


def snapshot_save(name, stamp):
    name = re.sub(r"[^A-Za-z0-9 _-]", "", name).strip()[:40] or "untitled"
    cam = refresh()
    if not cam["detected"]:
        return False, "no camera to snapshot"
    vals = {k: v.get("current") for k, v in cam["settings"].items()
            if v.get("current") is not None and not v.get("readonly")}
    SNAP_DIR.mkdir(parents=True, exist_ok=True)
    (SNAP_DIR / f"{name}.json").write_text(json.dumps(
        {"saved": stamp, "settings": vals}, indent=2))
    return True, f"saved {len(vals)} settings as “{name}”"


def snapshot_load(name):
    f = SNAP_DIR / f"{re.sub(r'[^A-Za-z0-9 _-]', '', name)}.json"
    if not f.is_file():
        return False, "no such snapshot", []
    if busy_job():
        return False, "camera busy", []
    want = json.loads(f.read_text()).get("settings", {})
    applied, refused = [], []
    with STATE_LOCK:
        keys = dict(STATE["keys"])
    with CAMERA_LOCK:
        for logical, val in want.items():
            path = keys.get(logical)
            if not path:
                continue
            rc, _, _ = gp(["--set-config", f"{path}={val}"], timeout=20)
            (applied if rc == 0 else refused).append(f"{logical}={val}")
    refresh(force=True)
    return True, f"{len(applied)} applied, {len(refused)} refused", refused


def card_list():
    """What is on the memory card, as the camera reports it."""
    if busy_job():
        return None, "camera busy"
    with CAMERA_LOCK:
        rc, out, err = gp(["--list-files"], timeout=60)
    if rc != 0:
        return None, (err or "could not list the card").strip()
    files, folder = [], ""
    for line in out.splitlines():
        m = re.match(r"^There (?:is|are) \d+ files? in folder '([^']*)'", line)
        if m:
            folder = m.group(1); continue
        m = re.match(r"^#(\d+)\s+(\S+)\s+(\S+)\s+(\S+)", line)
        if m:
            files.append({"index": int(m.group(1)), "name": m.group(2),
                          "size": m.group(3), "folder": folder})
    return files, None


def card_fetch(indices):
    """Pull selected frames off the card by index."""
    if busy_job():
        return False, "camera busy"
    dest = ROOT / "card"
    dest.mkdir(parents=True, exist_ok=True)
    if not isinstance(indices, list):
        return False, "indices must be a list of file numbers"
    args = []
    for i in indices:
        try:
            args += ["--get-file", str(int(i))]
        except (TypeError, ValueError):
            return False, f"not a file number: {i!r}"
    if not args:
        return False, "nothing selected"
    with CAMERA_LOCK:
        rc, _, err = gp(["--filename", str(dest / "%f.%C"), *args], timeout=300)
    if rc != 0:
        return False, (err or "download failed").strip()
    return True, f"{len(indices)} file(s) into {dest}"


def arm_bracket(count="3", step="2"):
    """Set up an auto-exposure bracket without menu diving."""
    with STATE_LOCK:
        keys = dict(STATE["keys"])
    if not keys.get("bracketing"):
        return False, "camera does not expose bracketing"
    if busy_job():
        return False, "camera busy"
    seq = [("bracketset", "AE only"), ("aebracketingcount", count),
           ("evstep", "1/3"), ("bracketing", "1")]
    done, failed = [], []
    with CAMERA_LOCK:
        for logical, val in seq:
            path = keys.get(logical)
            if not path:
                continue
            rc, _, _ = gp(["--set-config", f"{path}={val}"], timeout=20)
            (done if rc == 0 else failed).append(logical)
    refresh(force=True)
    return True, f"bracketing armed ({', '.join(done)})" + (f"; refused: {', '.join(failed)}" if failed else "")


# ─────────────────────────────────────────────────────── the guide, rendered ──
#
# README.md is the single source of truth. Rather than keep a second copy of the
# guide in HTML and let the two drift, the app renders the markdown at request
# time into the same CSS classes the rest of the interface uses.
#
# A deliberately small renderer: it covers exactly what the README contains —
# headings, fenced code, pipe tables, lists, blockquotes, rules, and inline
# code/bold/italic/links — and nothing else.

import html as _html

_INLINE_CODE = re.compile(r"`([^`]+)`")
_BOLD        = re.compile(r"\*\*([^*]+)\*\*")
_ITALIC      = re.compile(r"(?<![\*\w])\*([^*\n]+)\*(?!\*)")
_LINK        = re.compile(r"\[([^\]]+)\]\(([^)]+)\)")


def _inline(text):
    text = _html.escape(text, quote=False)
    stash = []

    def keep(m):
        stash.append(m.group(1))
        return f"\x00{len(stash)-1}\x00"

    text = _INLINE_CODE.sub(keep, text)
    text = _LINK.sub(r'<a href="\2" target="_blank" rel="noreferrer">\1</a>', text)
    text = _BOLD.sub(r"<strong>\1</strong>", text)
    text = _ITALIC.sub(r"<em>\1</em>", text)
    for i, code in enumerate(stash):
        text = text.replace(f"\x00{i}\x00", f"<code>{code}</code>")
    return text


def _slug(text):
    keep = [c.lower() if c.isalnum() else "-" for c in text]
    out = "".join(keep)
    while "--" in out:
        out = out.replace("--", "-")
    return out.strip("-")[:60]


def render_markdown(md):
    """Return (html, toc). toc is a list of {level, text, id} for h2/h3."""
    lines = md.split("\n")
    out, toc = [], []
    i, n = 0, len(lines)

    def close_list(stack):
        while stack:
            out.append(f"</{stack.pop()}>")

    liststack = []

    while i < n:
        line = lines[i]

        # fenced code
        if line.startswith("```"):
            close_list(liststack)
            i += 1
            buf = []
            while i < n and not lines[i].startswith("```"):
                buf.append(lines[i]); i += 1
            i += 1
            out.append("<pre><code>" + _html.escape("\n".join(buf)) + "</code></pre>")
            continue

        # pipe table: a header row followed by a |---| separator
        if line.strip().startswith("|") and i + 1 < n and set(lines[i+1].replace("|", "").strip()) <= set("-: "):
            close_list(liststack)
            def cells(r):
                r = r.strip()
                if r.startswith("|"): r = r[1:]
                if r.endswith("|"):   r = r[:-1]
                return [c.strip() for c in r.split("|")]
            head = cells(line); i += 2
            rows = []
            while i < n and lines[i].strip().startswith("|"):
                rows.append(cells(lines[i])); i += 1
            t = ['<div class="scroll"><table><thead><tr>']
            t += [f"<th>{_inline(c)}</th>" for c in head]
            t.append("</tr></thead><tbody>")
            for r in rows:
                t.append("<tr>" + "".join(f"<td>{_inline(c)}</td>" for c in r) + "</tr>")
            t.append("</tbody></table></div>")
            out.append("".join(t))
            continue

        # headings
        if line.startswith("#"):
            close_list(liststack)
            lvl = len(line) - len(line.lstrip("#"))
            text = line[lvl:].strip()
            if lvl == 1:
                i += 1; continue                      # the page already has a title
            sid = _slug(text)
            if lvl in (2, 3):
                toc.append({"level": lvl, "text": re.sub(r"[*`]", "", text), "id": sid})
            tag = {2: "h3", 3: "h4", 4: "h4", 5: "h4", 6: "h4"}[lvl]
            cls = ' class="g-h2"' if lvl == 2 else ""
            out.append(f'<{tag} id="{sid}"{cls}>{_inline(text)}</{tag}>')
            i += 1; continue

        # horizontal rule
        if line.strip() in ("---", "***", "___"):
            close_list(liststack); out.append("<hr>"); i += 1; continue

        # blockquote
        if line.startswith(">"):
            close_list(liststack)
            buf = []
            while i < n and lines[i].startswith(">"):
                buf.append(lines[i].lstrip("> ").rstrip()); i += 1
            out.append(f'<div class="note"><p>{_inline(" ".join(buf))}</p></div>')
            continue

        # lists
        m_ul = re.match(r"^(\s*)[-*]\s+(.*)$", line)
        m_ol = re.match(r"^(\s*)\d+\.\s+(.*)$", line)
        if m_ul or m_ol:
            want = "ul" if m_ul else "ol"
            body = (m_ul or m_ol).group(2)
            if not liststack or liststack[-1] != want:
                close_list(liststack)
                out.append(f"<{want}>"); liststack.append(want)
            out.append(f"<li>{_inline(body)}</li>")
            i += 1; continue

        if not line.strip():
            close_list(liststack); i += 1; continue

        # paragraph
        close_list(liststack)
        buf = [line]
        i += 1
        while i < n and lines[i].strip() and not re.match(r"^(#|```|>|\||\s*[-*]\s|\s*\d+\.\s|---$)", lines[i]):
            buf.append(lines[i]); i += 1
        out.append(f"<p>{_inline(' '.join(buf))}</p>")

    close_list(liststack)
    return "\n".join(out), toc


_GUIDE_CACHE = {"mtime": None, "html": None, "toc": None, "src": None}


def render_guide_cached(src):
    """Render once, then serve from memory until the file changes.

    Rendering the README is ~100 ms of pure CPU. Doing it per request meant a
    handful of concurrent clients could saturate the box — found by throwing
    sixty parallel requests at it, which hung. Keyed on mtime so editing the
    README still shows up on the next load.
    """
    st = src.stat()
    key = (str(src), st.st_mtime_ns, st.st_size)
    if _GUIDE_CACHE["mtime"] != key:
        html_, toc = render_markdown(src.read_text(encoding="utf-8", errors="replace"))
        _GUIDE_CACHE.update(mtime=key, html=html_, toc=toc, src=str(src))
    return _GUIDE_CACHE["html"], _GUIDE_CACHE["toc"]


def guide_source():
    """The bundled README, or the one in the checkout when run from source."""
    for c in (HERE / "README.md", PROJECT / "README.md"):
        if c.is_file():
            return c
    return None


# ────────────────────────────────────────────────────────────────────── http ──

def jbody(handler):
    n = int(handler.headers.get("Content-Length") or 0)
    if not n:
        return {}
    try:
        return json.loads(handler.rfile.read(n).decode())
    except Exception:                                           # noqa: BLE001
        return {}


class Handler(BaseHTTPRequestHandler):
    server_version = "d70-studio"

    def log_message(self, *a):                                  # quiet
        pass

    def _send(self, code, body, ctype="application/json"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode()
        elif isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    # A malformed request should return 500 and a message, never take down the
    # thread and leave the client hanging with no status at all.
    def handle_one_request(self):
        try:
            super().handle_one_request()
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception as exc:                                # noqa: BLE001
            try:
                self._send(500, {"ok": False, "message": f"{type(exc).__name__}: {exc}"})
            except Exception:                                   # noqa: BLE001
                pass

    # ------------------------------------------------------------------ GET --
    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        p, q = u.path, urllib.parse.parse_qs(u.query)

        if p in ("/", "/index.html"):
            try:
                return self._send(200, UI_FILE.read_text(), "text/html; charset=utf-8")
            except FileNotFoundError:
                return self._send(500, f"<h1>missing {UI_FILE}</h1>", "text/html")

        if p == "/api/boot":
            return self._send(200, {
                "root": str(ROOT), "project": str(PROJECT),
                "gphoto2": shutil.which("gphoto2") or "",
                "tools": {t: bool(shutil.which(t)) for t in
                          ("gphoto2", "exiftool", "magick", "ffmpeg", "dcraw_emu",
                           "align_image_stack", "enfuse")},
                "recipes": RECIPES,
                "projects": projects_view(OWNED),
                "gear": gear_view(OWNED),
                "gearCats": [c for c in
                             ["Core","Support","Light","Filter","Optics",
                              "Target","Rig","Software"]
                             if any(g["cat"] == c for g in GEAR)],
                "glossary": GLOSSARY, "glossaryCats": GLOSSARY_CATS,
                "families": FAMILIES,
                "jobspecs": {k: {kk: vv for kk, vv in v.items() if kk != "script"}
                             for k, v in JOB_SPECS.items()},
                "codes": DISPLAY_CODES, "traps": TRAPS, "resets": RESETS,
                "groups": [{"name": n, "keys": k} for n, k in GROUPS],
                "actions": ACTIONS,
            })

        if p == "/api/status":
            return self._send(200, {"camera": refresh(force=("force" in q)),
                                    "busy": busy_job()})

        if p == "/api/jobs":
            return self._send(200, {"jobs": job_view(), "busy": busy_job()})

        if p == "/api/guide":
            src = guide_source()
            if not src:
                return self._send(404, {"ok": False,
                                        "message": "README.md not found beside the app"})
            body, toc = render_guide_cached(src)
            return self._send(200, {"ok": True, "html": body, "toc": toc,
                                    "source": str(src)})

        if p == "/api/gear":
            return self._send(200, {"gear": gear_view(OWNED),
                                    "owned": sorted(OWNED),
                                    "projects": projects_view(OWNED)})

        if p == "/api/frame":
            rel = (q.get("path") or [""])[0]
            rows, err = frame_meta(rel)
            hist = frame_histogram(rel)
            found = rows is not None            # [] is a valid answer: no EXIF
            return self._send(200 if found else 404,
                              {"ok": found, "path": rel, "exif": rows or [],
                               "hist": hist,
                               "message": err or ("" if rows else "no EXIF in this file")})

        if p == "/api/snapshots":
            return self._send(200, {"snapshots": snapshot_list()})

        if p == "/api/card":
            files, err = card_list()
            return self._send(200 if files is not None else 400,
                              {"ok": files is not None, "files": files or [],
                               "message": err or ""})

        if p == "/api/frames":
            return self._send(200, {"frames": recent_frames()})

        if p.startswith("/frame/"):
            rel = urllib.parse.unquote(p[len("/frame/"):])
            target = (ROOT / rel).resolve()
            try:
                target.relative_to(ROOT.resolve())
            except ValueError:
                return self._send(403, {"error": "outside the library"})
            if not target.is_file():
                return self._send(404, {"error": "not found"})
            ctype = mimetypes.guess_type(str(target))[0] or "application/octet-stream"
            data = target.read_bytes()
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            return self.wfile.write(data)

        return self._send(404, {"error": "no such route"})

    # ----------------------------------------------------------------- POST --
    def do_POST(self):
        p = urllib.parse.urlparse(self.path).path
        body = jbody(self)

        if p == "/api/config":
            ok, msg = set_setting(body.get("key", ""), body.get("value", ""))
            refresh(force=True)
            return self._send(200 if ok else 400, {"ok": ok, "message": msg})

        if p == "/api/recipe":
            rec = next((r for r in RECIPES if r["id"] == body.get("id")), None)
            if not rec:
                return self._send(404, {"ok": False, "message": "no such recipe"})
            applied, refused = [], []
            for k, v in rec["set"].items():
                ok, msg = set_setting(k, v)
                (applied if ok else refused).append(msg)
            refresh(force=True)
            return self._send(200, {"ok": True, "applied": applied,
                                    "refused": refused, "manual": rec["manual"]})

        if p == "/api/gear":
            global OWNED
            gid = body.get("id")
            bulk = body.get("all")
            if bulk is not None and not isinstance(bulk, list):
                # Without this a stray string iterated to characters, matched
                # nothing, and quietly reset the owner's whole kit list.
                return self._send(400, {"ok": False,
                                        "message": "'all' must be a list of gear ids"})
            if bulk is None and not (isinstance(gid, str) and gid in GEAR_BY_ID):
                return self._send(400, {"ok": False, "message": f"unknown gear id {gid!r}"})

            # Read-modify-write under the same lock save_gear uses, so two
            # concurrent ticks cannot lose one another's change.
            with GEAR_LOCK:
                if bulk is not None:
                    # Only strings can be gear ids; a dict would be unhashable.
                    OWNED = {g for g in bulk
                             if isinstance(g, str) and g in GEAR_BY_ID} | set(CORE)
                elif body.get("owned"):
                    OWNED = OWNED | {gid}
                else:
                    OWNED = (OWNED - {gid}) | set(CORE)
                snapshot = set(OWNED)
            save_gear(snapshot)
            return self._send(200, {"ok": True, "owned": sorted(snapshot),
                                    "gear": gear_view(snapshot),
                                    "projects": projects_view(snapshot)})

        if p == "/api/preflight":
            return self._send(200, {"checks": preflight(body.get("kind", ""),
                                                        body.get("values") or {})})

        if p == "/api/tag":
            ok, msg = tag_project(body.get("n"))
            return self._send(200 if ok else 400, {"ok": ok, "message": msg})

        if p == "/api/snapshot/save":
            ok, msg = snapshot_save(body.get("name", ""), body.get("stamp", ""))
            return self._send(200 if ok else 400,
                              {"ok": ok, "message": msg, "snapshots": snapshot_list()})

        if p == "/api/snapshot/load":
            ok, msg, refused = snapshot_load(body.get("name", ""))
            return self._send(200 if ok else 400,
                              {"ok": ok, "message": msg, "refused": refused})

        if p == "/api/card/get":
            ok, msg = card_fetch(body.get("indices") or [])
            return self._send(200 if ok else 400, {"ok": ok, "message": msg})

        if p == "/api/bracket":
            ok, msg = arm_bracket(str(body.get("count", "3")), str(body.get("step", "2")))
            return self._send(200 if ok else 400, {"ok": ok, "message": msg})

        if p == "/api/capture":
            ok, msg = capture_now()
            return self._send(200 if ok else 400, {"ok": ok, "message": msg})

        if p == "/api/action":
            name = body.get("name", "")
            with STATE_LOCK:
                path = STATE["keys"].get(name)
            if not path:
                return self._send(404, {"ok": False, "message": f"no action {name}"})
            if busy_job():
                return self._send(400, {"ok": False, "message": "camera busy"})
            val = body.get("value", "1")
            with CAMERA_LOCK:
                rc, out, err = gp(["--set-config", f"{path}={val}"], timeout=30)
            ok = rc == 0
            refresh(force=True)
            return self._send(200 if ok else 400,
                              {"ok": ok, "message": (err or out or f"{name}={val}").strip()})

        if p == "/api/ptpcamerad":
            free_ptpcamerad()
            return self._send(200, {"ok": True, "message": "ptpcamerad released"})

        if p == "/api/job":
            jid, err = start_job(body.get("kind", ""), body.get("values") or {})
            return self._send(200 if jid else 400,
                              {"ok": bool(jid), "id": jid, "message": err or "started"})

        if p == "/api/job/stop":
            ok, msg = stop_job(body.get("id", ""))
            return self._send(200 if ok else 400, {"ok": ok, "message": msg})

        return self._send(404, {"error": "no such route"})


def main():
    ap = argparse.ArgumentParser(description="Local control surface for the Nikon D70")
    ap.add_argument("--port", type=int, default=8070)
    ap.add_argument("--host", default="127.0.0.1")
    args = ap.parse_args()

    ROOT.mkdir(parents=True, exist_ok=True)
    srv = ThreadingHTTPServer((args.host, args.port), Handler)

    print(f"d70-studio  →  http://{args.host}:{args.port}")
    print(f"library     →  {ROOT}")
    print(f"gphoto2     →  {shutil.which('gphoto2') or 'NOT INSTALLED — run ./bin/d70-setup'}")
    print("Ctrl-C to stop.\n")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nstopping…")
        for j in JOBS.values():
            if j["running"]:
                stop_job(j["id"])
        srv.shutdown()


if __name__ == "__main__":
    main()
